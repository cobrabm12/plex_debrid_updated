# Copy this file to ".env" and fill in any values you want to override.
# ".env" is gitignored, so your real credentials never end up in source control.

# Container timezone used by docker compose.
TZ=Europe/Bucharest

# Standalone Plex watchlist test script.
PLEX_TOKEN=

# Real-Debrid and optional OAuth/client overrides.
RD_API_KEY=
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
DEBRIDLINK_CLIENT_ID=
ORIONOID_CLIENT_ID=

# Optional local service profile defaults.
PUID=1000
PGID=1000
PLEX_CLAIM=
COMPOSE_PROFILES=
