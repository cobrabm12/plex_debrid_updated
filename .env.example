# Copy this file to ".env" and fill in any values you want to override.
# ".env" is gitignored, so your real credentials never end up in the code or git.
# Every value here is OPTIONAL: if left empty, plex_debrid falls back to the shared
# public defaults baked into the project, so it still works out of the box.

# Used by check_watchlist.py (the standalone watchlist test script).
PLEX_TOKEN=

# OAuth app credentials. Only set these if you want to use your OWN registered apps
# instead of the shared public plex_debrid defaults.
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
DEBRIDLINK_CLIENT_ID=
ORIONOID_CLIENT_ID=
